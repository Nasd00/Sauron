{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build:shared",
    "watchPatterns": ["services/cv/**", "packages/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start --workspace @tempmhacks/cv",
    "restartPolicyType": "ON_FAILURE"
  }
}
