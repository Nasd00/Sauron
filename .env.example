# SpacetimeDB used by photon, alerts and demo tools. Empty URI/database use the local server
# (http://127.0.0.1:3000, tempmhacks-local). For the hosted DB use https://maincloud.spacetimedb.com.
SPACETIMEDB_URI=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=

# Web app (apps/web). VITE_ values are built into public browser JavaScript: never put secrets here.
VITE_SPACETIMEDB_URI=http://127.0.0.1:3000
VITE_SPACETIMEDB_DATABASE=tempmhacks-local
# Photon base URL, so the globe can enroll phones for alerts. In production, photon's public URL.
VITE_PHOTON_URL=http://localhost:3001
# Optional map tokens. The globe uses OpenStreetMap without them.
VITE_CESIUM_ION_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

# Required by photon and alerts: the web app's URL, used in alert links and as the only browser
# origin allowed to enroll phones. In production, the Vercel URL.
PUBLIC_APP_URL=http://localhost:5173

# Photon Spectrum project and native-webhook credentials.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional: defaults to the project secret, which Photon uses to sign webhooks.
SPECTRUM_WEBHOOK_SECRET=
# Required by photon. Guards /admin/users, which can text any phone; also the operator key the
# globe asks for when enrolling a phone.
PHOTON_ADMIN_SECRET=
# Legacy aliases PHOTON_PROJECT_ID / PHOTON_SECRET are also accepted.
# Local port. Hosts like Railway set PORT instead, which photon uses when this is unset.
PHOTON_PORT=3001

# End-user-triggered geocoding. Replace the contact: OpenStreetMap rejects this placeholder (HTTP 403).
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Downwind/0.1 (contact: you@example.com)

# Radius in kilometers used to watch for incidents.
WATCH_RADIUS_KM=10

# Sauron iPhone location app (apps/ios). Public HTTPS URL of Photon (your ngrok URL);
# WATCH ME texts pairing links of the form <url>/pair/<token>. Unset disables WATCH ME.
MOBILE_PAIRING_BASE_URL=
# Optional: Apple team id, served in apple-app-site-association for universal links.
APPLE_TEAM_ID=
# Optional: app bundle id for universal links; defaults to com.tempmhacks.sauron.
MOBILE_APP_BUNDLE_ID=

# Optional help agent in photon (Gemini). Without a key Photon only answers its commands.
GEMINI_API_KEY=
# Optional model override, e.g. gemini-3-flash-preview. Empty uses gemini-flash-latest. An unknown
# name makes every agent reply fall back to "call 911 / call 211".
GEMINI_MODEL=
# Optional: people within this many km of a new incident get an offer of help (default 3), and
# ASSIST_DEMO_SHELTERS=0 drops the labeled Ann Arbor demo shelters.
# ASSIST_RADIUS_KM=3
# ASSIST_DEMO_SHELTERS=1

# Smoke detection (services/cv): samples every registered camera and asks Gemini whether each
# frame shows smoke or fire. Requires GEMINI_API_KEY above; every sampled frame is one Gemini call.
# CV_MODEL=gemini-flash-latest
# Milliseconds between frames for live webcams (default 30000) and the demo replay video (3000).
# CV_INTERVAL_MS=30000
# CV_REPLAY_INTERVAL_MS=3000
# Optional comma-separated camera ids to watch; empty watches them all.
# CV_CAMERA_IDS=

# Camera identifier used by demo tooling.
DEMO_CAMERA_ID=demo-camera-001

# Optional: IRIS voice assistant via xAI Grok Voice Agent. Server-side only.
# See apps/web/reference/.env.example for the full set of voice options.
VOICE_PROVIDER=xai
XAI_API_KEY=
