# SpacetimeDB server URI and database name.
SPACETIMEDB_URI=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=
VITE_SPACETIMEDB_URI=http://127.0.0.1:3000
VITE_SPACETIMEDB_DATABASE=tempmhacks-local

# Photon Spectrum project and native-webhook credentials.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional: defaults to the project secret, which Photon uses to sign webhooks.
SPECTRUM_WEBHOOK_SECRET=
PHOTON_ADMIN_SECRET=
# Legacy aliases PHOTON_PROJECT_ID / PHOTON_SECRET are also accepted.
PHOTON_PORT=3001

# End-user-triggered geocoding. Identify the app with a contact URL or email.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Downwind/0.1 (contact: you@example.com)

# Public URL of the web application.
PUBLIC_APP_URL=

# Optional. The globe uses OpenStreetMap without a token by default.
VITE_CESIUM_ION_TOKEN=

# Radius in kilometers used to watch for incidents.
WATCH_RADIUS_KM=10

# Sauron iPhone location app (apps/ios). Public HTTPS URL of Photon (your ngrok URL);
# WATCH ME texts pairing links of the form <url>/pair/<token>. Unset disables WATCH ME.
MOBILE_PAIRING_BASE_URL=
# Optional: Apple team id, served in apple-app-site-association for universal links.
APPLE_TEAM_ID=
# Optional: app bundle id for universal links; defaults to com.tempmhacks.sauron.
MOBILE_APP_BUNDLE_ID=

# Optional help agent in services/photon (Gemini). Without a key Photon only answers its commands.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-flash-latest.
GEMINI_MODEL=

# Camera identifier used by demo tooling.
DEMO_CAMERA_ID=demo-camera-001

# Evacuation assist (services/evac). Loopback API port used by the dashboard proxy.
EVAC_PORT=8787
# Seconds a volunteer driver has to answer before the request goes to the next one.
EVAC_HELPER_TIMEOUT_SEC=120
# 1 = no network calls: supplied scenario data and cached routes only.
EVAC_OFFLINE=
# Route these participants over iMessage (requires PHOTON_PROJECT_ID and PHOTON_SECRET).
# Format: participantId=handle,... e.g. resident-alex=+15550000000,helper-maya=+15550000001
EVAC_IMESSAGE_HANDLES=
