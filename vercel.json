{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build:web",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/incident/:id", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
